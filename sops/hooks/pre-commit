#!/usr/bin/env bash
# git pre-commit — AUTOMATIC ENCRYPTION (binary mode, exact round-trip).
# Any plaintext .env file whose content differs from its committed .sops is re-encrypted
# and staged. Only re-encrypts when the plaintext actually changed (no churn otherwise).
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"; cd "$ROOT" || exit 0

mapfile -t ENVS < <(find . -type f \( -name '.env' -o -name '.env.*' \) \
  ! -name '*.sops' ! -name '*.example' ! -name '*.sample' ! -name '*.template' \
  ! -path './.git/*' ! -path '*/node_modules/*' ! -path '*/.venv/*' ! -path '*/venv/*')
[ "${#ENVS[@]}" -eq 0 ] && exit 0
command -v sops >/dev/null 2>&1 || { echo "pre-commit[sops]: sops not installed; skipping." >&2; exit 0; }

dmode() { if [ "$(head -c1 "$1" 2>/dev/null)" = "{" ]; then echo binary; else case "$2" in *.yaml|*.yml) echo yaml;; *.json) echo json;; *) echo dotenv;; esac; fi; }

for f in "${ENVS[@]}"; do
  enc="$f.sops"
  if [ -f "$enc" ]; then
    dt="$(dmode "$enc" "$f")"
    if cur=$(sops -d --input-type "$dt" --output-type "$dt" "$enc" 2>/dev/null); then
      [ "$cur" = "$(cat "$f")" ] && continue   # unchanged -> no re-encrypt
    fi
  fi
  if sops -e --input-type binary --output-type binary "$f" > "$enc.tmp" 2>/tmp/sops_precommit.err; then
    mv "$enc.tmp" "$enc"; git add "$enc"
    echo "pre-commit[sops]: encrypted $f -> $enc (staged)"
  else
    rm -f "$enc.tmp"
    echo "pre-commit[sops]: FAILED to encrypt $f — commit blocked (stale .sops avoided)." >&2
    echo "  $(tail -1 /tmp/sops_precommit.err 2>/dev/null)" >&2
    echo "  fix: gcloud auth application-default login  (@flowgenx.ai account)" >&2
    exit 1
  fi
done
exit 0
